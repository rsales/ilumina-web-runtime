# ---------------------------------------------------------------------------
# iLumina Web Runtime — .gitignore
# Rule #1: never commit original iLumina / QuickTime content or install state
# (see docs/decisions/0003-bring-your-own-discs.md).
# ---------------------------------------------------------------------------

# --- Secrets / local config -------------------------------------------------
.env
.env.*
!.env.example
*.local

# --- User-supplied discs and anything extracted from them -------------------
discs/
media/
originals/
extracted/
mounted/
*.nrg
*.iso
*.bin
*.cue
*.img
*.dmg
*.toast
*.mdf
*.mds
*.hfs

# --- Director / Valentina / QuickTime / app files (copyrighted content) -----
*.dxr
*.dir
*.cxt
*.cst
*.x32
*.vdb
*.dat
*.blb
*.ind
*.mov
*.qtvr
*.qdat
iLuminaInfo.txt
Prefs/

# --- Runtime state, logs and screenshots (may show app content / secrets) ---
state/
logs/
screens/
*.log
*.png
*.jpg
!docs/**/*.svg

# --- Wine prefixes ----------------------------------------------------------
.wine/
prefix/
*.reg

# --- Agent / tool scratch ---------------------------------------------------
.claude/settings.local.json
.cursor/
.aider*
.ai-memory/
tmp/
*.tmp
*.bak
*.swp

# --- OS / editor ------------------------------------------------------------
.DS_Store
._*
.AppleDouble
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini
.idea/
.vscode/

# --- Node (Playwright tests, future landing page) ---------------------------
node_modules/
