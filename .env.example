# Copy to .env (never commit it). All values are optional.

# Folder with cd1/ cd2/ cd3/ cd4/ (also read by compose for the bind mount)
ILUMINA_MEDIA_DIR=/path/to/discs

# Typed into "Registre Sua Cópia do iLúmina" on first launch.
# The e-mail is part of what the activation code is issued for (step #2).
ILUMINA_REG_NAME=
ILUMINA_REG_EMAIL=
ILUMINA_REG_CEP=

# Typed into "Ativação do iLúmina" -> "Possuo o meu Código de Ativação".
# The code must have been issued for THIS installation's "#1" code
# (shown under Ativação por telefone). See docs/use-cases.md (UC4).
ILUMINA_ACTIVATION_CODE=
